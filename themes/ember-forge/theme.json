{
  "schema_version": 1,
  "id": "ember-forge",
  "name": "Ember Forge",
  "description": "Charcoal workshop glow with amber sparks for late-night ops.",
  "author": "master3395",
  "version": "1.2.0",
  "tokens": {
    "accent": "#f59e0b",
    "accent_focus": "#fbbf24",
    "radius_px": 10,
    "density": "comfortable",
    "font_scale": 1.0
  },
  "background": {
    "color_mode": "dark",
    "body": "linear-gradient(155deg, rgba(20,12,8,0.7) 0%, rgba(16,10,8,0.8) 100%)",
    "sidebar": "linear-gradient(180deg, rgba(22,14,10,0.9) 0%, rgba(16,10,8,0.94) 100%)",
    "surface": "#100a08",
    "canvas": "#1a110c",
    "surface_soft": "#22160f",
    "ink": "#fff1e0",
    "muted": "#c4a484",
    "hairline": "#3d2a1c",
    "preview": "linear-gradient(135deg, #140c08 0%, #7c2d12 45%, #f59e0b 100%)",
    "image": "assets/bg.webp",
    "preview_image": "assets/preview.webp"
  }
}
